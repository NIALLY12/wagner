<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Atividade - Funções em JavaScript</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin-top: 50px;
            background-color: #f4f4f9;
        }
        .container {
            background-color: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            display: inline-block;
        }
        h1 {
            color: #333;
        }
        .mensagem {
            font-size: 18px;
            color: #555;
            margin: 20px 0;
            min-height: 50px;
        }
        .botao {
            padding: 10px 20px;
            font-size: 16px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.3s;
        }
        .botao:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Título da página -->
        <h1>Curiosidades Tech 🚀</h1>
        
        <!-- Área onde será exibida a mensagem -->
        <p class="mensagem">Clique no botão abaixo para descobrir um fato curioso!</p>
        
        <!-- Botão que dispara a função -->
        <button class="botao">Gerar Curiosidade</button>
    </div>

    <script>
        // Seleção dos elementos do HTML
        const botao = document.querySelector(".botao");
        const mensagem = document.querySelector(".mensagem");

        // Lista de curiosidades para alternar a cada clique
        const curiosidades = [
            "O primeiro bug de computador foi um inseto real (uma mariposa) preso em um relé em 1947!",
            "O primeiro computador eletrônico (ENIAC) pesava mais de 27 toneladas e ocupava uma sala inteira.",
            "Cerca de 92% da moeda do mundo inteiro existe apenas em formato digital nos computadores.",
            "O primeiro endereço de site da história foi 'info.cern.ch', criado em 1991."
        ];

        // Função que será executada ao clicar no botão
        function mostrarCuriosidade() {
            // Sorteia uma posição aleatória da lista de curiosidades
            const indiceAleatorio = Math.floor(Math.random() * curiosidades.length);
            
            // Altera visivelmente o texto na página
            mensagem.textContent = curiosidades[indiceAleatorio];
            
            // Altera também a cor do texto para dar um destaque visual extra
            mensagem.style.color = "#28a745"; 
        }

        // Ouvinte de evento: executa a função ao clicar no botão
        botao.addEventListener("click", mostrarCuriosidade);
    </script>

</body>
</html>
